# Configuración del LLM (Google Gemini / OpenAI)
LLM_PROVIDER=gemini
GEMINI_API_KEY=tu_apikey_aqui

# Configuración de Oracle Cloud Infrastructure (OCI Always Free)
OCI_CONFIG_PROFILE=DEFAULT
OCI_TENANCY_OCID=ocid1.tenancy.oc1..ejemplo
OCI_USER_OCID=ocid1.user.oc1..ejemplo
OCI_FINGERPRINT=00:00:00:00:00:00:00:00
OCI_KEY_FILE=~/.oci/oci_api_key.pem
OCI_REGION=us-ashburn-1
OCI_BUCKET_NAME=communitylab-activos-marketing